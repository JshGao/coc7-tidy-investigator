<div class="c7t-toolbar">
  <span class="c7t-toolbar-title">{{localize 'C7TIDY.Npc.Inventory'}}</span>
  <span class="c7t-toolbar-spacer"></span>
  <span class="c7t-toolbar-hint">{{localize 'C7TIDY.Npc.InventoryHint'}}</span>
</div>

{{#each inventory.groups as |group|}}
  <div class="c7t-group{{#if group.collapsed}} is-collapsed{{else}} is-open{{/if}}">
    <div class="c7t-group-head">
      <button type="button" class="c7t-group-toggle" data-action="toggleGroup" data-type="{{group.type}}"
        data-tooltip="C7TIDY.Action.Collapse">
        <i class="fa-solid fa-chevron-down"></i>
      </button>
      <span class="c7t-group-title">{{localize group.label}}</span>
      <span class="c7t-group-meta">{{group.count}}</span>
      {{#if @root.isEditing}}
        <button type="button" class="c7t-icon-btn" data-action="createItem" data-type="{{group.type}}"
          data-tooltip="C7TIDY.Action.CreateItem"><i class="fa-solid fa-plus"></i></button>
      {{/if}}
    </div>
    <div class="c7t-group-body c7t-items-list">
      {{#each group.items as |item|}}
        <div class="c7t-row" data-item-id="{{item.id}}" data-action="openItem"
          draggable="{{#if @root.isEditing}}true{{else}}false{{/if}}">
          <span class="col-name">
            {{#if item.img}}<img class="c7t-row-ico" src="{{item.img}}" alt="">{{else}}<i class="c7t-row-ico"><i class="fa-solid fa-cube"></i></i>{{/if}}
            <span class="c7t-row-name">{{item.name}}</span>
          </span>
          {{#if item.isStackable}}
            {{#if @root.isEditing}}
              <span class="c7t-qty">
                <span class="c7t-qty-mark" aria-hidden="true">×</span>
                <input class="c7t-qty-input" type="number" min="0" step="1" value="{{item.quantity}}"
                  data-tooltip="{{localize 'C7TIDY.Items.Quantity'}}">
              </span>
            {{else}}
              {{#if item.note}}<span class="c7t-row-note">{{item.note}}</span>{{/if}}
            {{/if}}
          {{else}}
            {{#if item.note}}<span class="c7t-row-note">{{item.note}}</span>{{/if}}
          {{/if}}
          <span class="col-act">
            <button type="button" class="c7t-icon-btn" data-action="openItem" data-tooltip="C7TIDY.Action.OpenItem">
              <i class="fa-solid fa-pen"></i>
            </button>
            {{#if @root.isEditing}}
              <button type="button" class="c7t-icon-btn" data-action="deleteItem" data-tooltip="C7TIDY.Action.DeleteItem">
                <i class="fa-solid fa-trash"></i>
              </button>
            {{/if}}
          </span>
        </div>
      {{/each}}
    </div>
  </div>
{{else}}
  <div class="c7t-empty">
    <b>{{localize 'C7TIDY.Items.Empty'}}</b>
    <p>{{localize 'C7TIDY.Npc.InventoryEmptyHint'}}</p>
  </div>
{{/each}}

<div class="c7t-table-foot">{{localize 'C7TIDY.Npc.InventoryFoot'}}</div>
