<div class="c7t-toolbar">
  <span class="c7t-toolbar-title">{{localize 'C7TIDY.Npc.Keeper'}}</span>
  <span class="c7t-gm-badge">{{localize 'C7TIDY.Npc.GMOnly'}}</span>
  <span class="c7t-toolbar-spacer"></span>
  <span class="c7t-toolbar-hint">{{localize 'C7TIDY.Npc.KeeperHint'}}</span>
</div>

<div class="c7t-section c7t-npc-section is-keeper">
  <div class="c7t-section-head">{{localize 'C7TIDY.Notes.Keeper'}}</div>
  {{#if isEditing}}
    <prose-mirror class="c7t-npc-prose" name="system.description.keeper"
      value="{{npcText.keeper}}" data-document-uuid="{{actor.uuid}}" toggled>{{{npcText.keeperHtml}}}</prose-mirror>
  {{else}}
    <div class="c7t-prose c7t-npc-prose">{{{npcText.keeperHtml}}}</div>
  {{/if}}
</div>

<div class="c7t-section c7t-npc-section">
  <div class="c7t-section-head">
    {{localize 'C7TIDY.Npc.Macros'}}
    <span class="c7t-section-meta">{{localize 'C7TIDY.Npc.MacrosHint'}}</span>
  </div>
  <div class="c7t-macros">
    {{#each macros as |macro|}}
      <div class="c7t-macro-row{{#if macro.missing}} is-missing{{/if}}">
        {{#if macro.img}}
          <img class="c7t-row-ico" src="{{macro.img}}" alt="">
        {{else}}
          <i class="c7t-row-ico"><i class="fa-solid fa-dice-d20"></i></i>
        {{/if}}
        <span class="c7t-macro-name">{{macro.name}}</span>
        <button type="button" class="c7t-icon-btn" data-action="executeMacro" data-uuid="{{macro.uuid}}"
          data-tooltip="C7TIDY.Npc.MacroExecute"><i class="fa-solid fa-burst"></i></button>
        {{#if @root.isEditing}}
          <button type="button" class="c7t-icon-btn" data-action="removeMacro" data-uuid="{{macro.uuid}}"
            data-tooltip="C7TIDY.Npc.MacroDelete"><i class="fa-solid fa-trash"></i></button>
        {{/if}}
      </div>
    {{else}}
      <div class="c7t-empty c7t-empty-slim">
        <b>{{localize 'C7TIDY.Npc.NoMacros'}}</b>
        <p>{{localize 'C7TIDY.Npc.MacrosEmptyHint'}}</p>
      </div>
    {{/each}}
    <div class="c7t-macro-drop-hint">{{localize 'C7TIDY.Npc.MacroDropHint'}}</div>
  </div>
</div>

<div class="c7t-section c7t-npc-section">
  <div class="c7t-section-head">{{localize 'C7TIDY.Notes.Conditions'}}</div>
  <div class="c7t-keeper-actions">
    <button type="button" class="c7t-btn" data-action="clearConditions">
      <i class="fa-solid fa-broom"></i>{{localize 'C7TIDY.Notes.ClearConditions'}}
    </button>
    <span class="c7t-toolbar-hint">{{localize 'C7TIDY.Npc.ClearConditionsHint'}}</span>
  </div>
</div>
